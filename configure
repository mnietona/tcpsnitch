#!/usr/bin/env bash
readonly CONFIG=.config.in
readonly TOP_PID=$$

readonly MISSING_LIB="Error: missing library dependency"
readonly MISSING_JANSSON="$MISSING_LIB libjansson-dev (see www.digip.org/jansson)"
readonly MISSING_PCAP="$MISSING_LIB libpcap-dev (see www.tcpdump.org)"
readonly MISSING_BPF="$MISSING_LIB libbpf-dev (required for eBPF CO-RE)"

readonly MISSING_TOOL="Error: missing build tool"
readonly MISSING_CLANG="$MISSING_TOOL clang (required compiler for eBPF targets)"
readonly MISSING_BPFTOOL="$MISSING_TOOL bpftool (required to generate BPF skeleton)"

trap "exit 1" TERM

error() {
    declare msg="$1"
    echo "$0: ${msg}"
    kill -s TERM $TOP_PID
}

supports_i386() {
    declare cc_text="$(echo | (gcc -E -Wp,-v - > /dev/null) 2>&1)"
    declare prog="BEGIN { f=0 };
    /include <\.\.\.> search starts here:/ { f=1; next };
    /^End/ { f=0; next };
    f { print}"

    declare include_path="$(echo "$cc_text" | awk "$prog")"
    echo "supports_i386=false" > "$CONFIG"
    
    while read -r line; do
        if [ -e "$line/gnu/stubs-32.h" ]; then
            sed -i -E "s/(supports_i386=).*/\1true/" "$CONFIG"
            exit 0
        fi
    done <<< "$include_path"
    exit 1
}

assert_lib_present() {
    declare lib="$1"
    declare error_msg="$2"
    if ! /sbin/ldconfig -p | grep -q "$lib"; then
        error "$error_msg"
    fi
}

assert_tool_present() {
    declare tool="$1"
    declare error_msg="$2"
    if ! command -v "$tool" >/dev/null 2>&1; then
        error "$error_msg"
    fi
}

echo "[-] Checking presence of compilation tools..."
assert_tool_present "clang" "$MISSING_CLANG"
assert_tool_present "bpftool" "$MISSING_BPFTOOL"

echo "[-] Checking presence of library dependencies..."
assert_lib_present "libjansson" "$MISSING_JANSSON"
assert_lib_present "libpcap" "$MISSING_PCAP"
assert_lib_present "libbpf" "$MISSING_BPF"

echo "[-] Checking presence of 64-bit architecture..."
if $(supports_i386); then
    echo "[-] 32-bit (i386) compatibility libraries found."
else
    echo "[-] 32-bit support is disabled (missing 32-bit headers)."
fi

echo "[-] Ok! All Linux dependencies are present."
echo "[-] Issue \"make && sudo make install\" to compile & install tcpsnitch."