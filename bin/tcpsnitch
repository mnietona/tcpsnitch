#!/usr/bin/env bash
set -o nounset
# set -o xtrace

###############################################################################
#                                 CONSTANTS                                   #
###############################################################################

readonly NAME="tcpsnitch"
readonly VERSION="0.1"
readonly VERSION_STR="${NAME} version ${VERSION}"

readonly I386_LIB="lib${NAME}.so.${VERSION}-i386"
readonly AMD64_LIB="lib${NAME}.so.${VERSION}-x86-64"
readonly ARM_LIB="lib${NAME}.so.${VERSION}-arm64"
readonly ARM_LIB_EBPF="lib${NAME}.so.${VERSION}-arm64-ebpf"
readonly DEPS_PATH="/usr/local/bin/${NAME}_deps"

readonly SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
readonly CWD=$(pwd)
readonly TOP_PID=$$
readonly PROP_PREFIX="be.ucl.${NAME}"

# Option default values
OPT_A=0
OPT_B=4096   
OPT_C=0  
OPT_D=""
OPT_E=0 
OPT_F=2   
OPT_L=2
OPT_T=1000
OPT_U=100000 
OPT_V=0

# Options saved in meta files
META_OPTIONS_NAMES=(opt_b opt_f opt_u)
META_OPTIONS_COUNT=${#META_OPTIONS_NAMES[@]}
META_OPTIONS_VALS=("$OPT_B" "$OPT_F" "$OPT_U")


###############################################################################
#                                  OPTIONS                                    #
###############################################################################

usage() {
    local _head="Usage: ${NAME}"
    local _skip=$(printf "%0.s " $(seq 1 ${#_head}))
    
    echo "${_head} [-acehv] [ -b <bytes> ] [ -d <dir>] [ -f <lvl> ]"
    echo "${_skip} [ -k <pkg> ] [ -l <lvl> ] [ -t <msec> ]"
    echo "${_skip} [ -u <usec> ] [ --version ] <app> [<args>]"
    echo ""
    echo "<app>       cmd/package to spy on."
    echo "<args>      args to <app>."
    echo "-a          instrument & launch app on connected android device."
    echo "-b <bytes>  dump tcp_info every <bytes> (def 4096)."
    echo "-c          is used for capturing pcap traces of the sockets. See section \"Packet capture\" for more info."
    echo "-d <dir>    Base output directory (defaults to /tmp/tcpsnitch_output)."
    echo "-e          activate eBPF capture (requires root/sudo on Linux)."
    echo "-f <lvl>    verbosity of logs to file (0 to 5, defaults to 2)."
    echo "-h          show this help text."
    echo "-k <pkg>    kill instrumented android <pkg> and pull traces."
    echo "-l <lvl>    verbosity of logs to stderr (0 to 5, defaults to 2)."
    echo "-t <msec>   dump to JSON file every <msec> (def. 1000)."
    echo "-u <usec>   dump tcp_info every <usec> (def 100000 i.e. 100ms)."
    echo "-v          activate verbose output (shows app stdout/stderr)."
    echo "--version   print ${NAME} version."
}

parse_options() {
    while getopts ":acehvb:d:f:k:l:t:u:-:" opt; do
        case "${opt}" in
            -) 
                case "${OPTARG}" in
                    version)
                        info "${VERSION_STR}"
                        exit 0
                        ;;
                esac
                ;;
            a) OPT_A=1 ;;
            b) assert_int "${OPTARG}" "invalid -b argument" ; OPT_B=${OPTARG} ;;
            c) OPT_C=1 ;;
            d) 
                if [[ ! -d "${OPTARG}" ]] ; then
                    mkdir -p "${OPTARG}"
                fi
                OPT_D=$(readlink -f "$OPTARG")
                ;;
            e) OPT_E=1 ;; 
            f) assert_int "${OPTARG}" "invalid -f argument" ; OPT_F=${OPTARG} ;;
            k) tcpsnitch_android_teardown "$@" ; exit 0 ;;
            l) assert_int "${OPTARG}" "invalid -l argument" ; OPT_L=${OPTARG} ;;
            u) assert_int "${OPTARG}" "invalid -u argument" ; OPT_U=${OPTARG} ;;
            t) assert_int "${OPTARG}" "invalid -t argument" ; OPT_T=${OPTARG} ;;
            v) ((OPT_V++)) ;;
            \?) error "invalid option" ;;
        esac
    done
}


###############################################################################
#                                  HELPERS                                    #
###############################################################################

error() {
    local msg="$1"
    echo "${NAME}: ${msg}."
    kill -s TERM $TOP_PID
}

info() {
    echo "[tcpsnitch] ${1}"
}

is_integer() {
    [[ "$1" =~ ^[0-9]+$ ]]
}

assert_int() {
    local int="$1"
    local error_msg="$2"
    if ! is_integer "$int"; then
        error "$error_msg"
    fi
}

cd_script_dir() {
    cd "$SCRIPT_DIR" || { echo "Could not cd to ${SCRIPT_DIR}"; exit 1; }
}

assert_lib_present() {
    local lib="$1"
    if [[ ! -f "$lib" ]]; then
        error "${lib} missing! You must compile and install the target: sudo make install"
    fi
}

validate_args_number() {
    if [[ $# -lt 1 ]]; then
        error "too few arguments"
    fi
}

create_opt_d_dir() {
    if [[ -z "$OPT_D" ]]; then
        OPT_D=$(mktemp -d)
        chmod 777 "$OPT_D"
    fi
}


###############################################################################
#                              ANDROID HELPERS                                #
###############################################################################

get_android_package() {
    local package_name="$1"

    if [[ $# -ne 1 ]]; then
        error "missing package argument"
    fi

    if [[ $(adb devices | wc -l) -ne 3 ]]; then
        error "adb must see exactly 1 device"
    fi

    local prefix="package:"
    local match
    match=$(adb shell pm list packages | grep -m 1 -s "${package_name}" | tr -d '\r')

    if [[ -z "${match}" ]]; then
        error "invalid argument: package '${package_name}' not found"
    fi

    PACKAGE=${match#${prefix}}
    info "Found Android package: '${PACKAGE}'"
}

start_android_package() {
    adb shell "monkey -p ${PACKAGE} -c android.intent.category.LAUNCHER 1 >/dev/null"
    info "Start package '${PACKAGE}'"
}

kill_android_package() {
    adb shell su -c am force-stop "${PACKAGE}"
}

pull_trace_for_android_package() {
    local tracesdir="/data/data/${PACKAGE}/${NAME}"
    local exists
    
    exists=$(adb shell su -c "'test -d ${tracesdir} && echo 0 || echo 1'" | tr -d '\r')
    if [[ "$exists" -eq "1" ]] ; then
        error "no traces for '${PACKAGE}'"
    fi

    info "Pulling trace from Android device..."
    adb shell su -c "cp -r $tracesdir /data/local/tmp/${NAME}_traces"
    adb shell su -c "chown -R shell:shell /data/local/tmp/${NAME}_traces"
    
    adb pull "/data/local/tmp/${NAME}_traces" "$OPT_D" 2>/dev/null
    mv "$OPT_D/${NAME}_traces/"* "$OPT_D/" 2>/dev/null
    rm -rf "$OPT_D/${NAME}_traces"

    chmod -R 777 "$OPT_D" 2>/dev/null
    
    adb shell su -c "rm -rf $tracesdir /data/local/tmp/${NAME}_traces"
    info "Trace saved in $OPT_D"
}


###############################################################################
#                                  LINUX                                      #
###############################################################################

tcpsnitch_linux() {
    if [[ -f "$cmd" ]]; then
        cmd=$(readlink -f "$cmd")
        set -- "$cmd" "${@:2}"

        if [[ ! -x "$cmd" ]]; then
            error "invalid cmd: '$cmd' is not executable"
        fi
    else
        if ! command -v "$cmd" > /dev/null; then
            error "invalid argument: '$cmd' is not in \$PATH"
        fi
    fi

    cd_script_dir
    
    if [[ -f "enable_i386" ]] && [[ "$(cat enable_i386)" == "true" ]]; then
        readonly ENABLE_I386=true
    else
        readonly ENABLE_I386=false
    fi

    if [[ "$ENABLE_I386" == "true" ]]; then
        assert_lib_present "$I386_LIB"
    fi
    assert_lib_present "$AMD64_LIB"
    
    readonly LINUX_GIT_HASH=$(cat linux_git_hash)

    # Output directory setup
    local BASE_DIR="${OPT_D:-/tmp/tcpsnitch_output}"
    IFS='/' read -ra array <<< "$1"
    local app=${array[-1]}
    
    local TIMESTAMP=$(date +%Y%m%d_%H%M%S)
    local UNIQUE_NAME="${app}_${TIMESTAMP}"
    local RUN_DIR="${BASE_DIR}/${UNIQUE_NAME}"
    local meta_dir="$RUN_DIR/meta"
    
    mkdir -p "$meta_dir"

    chmod 777 "$RUN_DIR" "$meta_dir"

    # Write meta data
    echo "$app"          > "${meta_dir}/app"
    echo "$@"            > "${meta_dir}/cmd"
    uname -r             > "${meta_dir}/kernel"
    uname -m             > "${meta_dir}/machine"
    sysctl net           > "${meta_dir}/net" 2>/dev/null
    uname -s             > "${meta_dir}/os"
    echo "$VERSION"      > "${meta_dir}/version"
    echo "$LINUX_GIT_HASH"> "${meta_dir}/git_hash"
    
    if ! ip link | grep 'link/ether' | awk '{print $2}' | sha256sum | awk '{print $1}' > "${meta_dir}/host_id"; then
        ifconfig | grep 'HWaddr' | awk '{print $NF}' | sha256sum | awk '{print $1}' > "${meta_dir}/host_id"
    fi
    
   # "$1" --version 2>/dev/null > "${meta_dir}/app_version"
    ( "$@" --version > "${meta_dir}/app_version" ) 2>/dev/null || true
    
    for i in $(seq 0 $((${META_OPTIONS_COUNT}-1))); do
        echo "${META_OPTIONS_VALS[$i]}" > "${meta_dir}/${META_OPTIONS_NAMES[$i]}"
    done

    # Build LD_PRELOAD
    local _preload_opt=""
    if [[ "$ENABLE_I386" == "true" ]]; then
        _preload_opt+="$(readlink -f "$I386_LIB") "
    fi
    _preload_opt+=$(readlink -f "$AMD64_LIB")

    cd "$CWD" || exit 1
    exec 3>&1
    
    # Environment variables execution block
    if [[ $OPT_V -gt 0 ]]; then
        TCPSNITCH_OPT_B=$OPT_B TCPSNITCH_OPT_C=$OPT_C TCPSNITCH_OPT_D=$RUN_DIR \
        TCPSNITCH_OPT_E=$OPT_E TCPSNITCH_OPT_F=$OPT_F TCPSNITCH_OPT_L=$OPT_L \
        TCPSNITCH_OPT_T=$OPT_T TCPSNITCH_OPT_U=$OPT_U TCPSNITCH_OPT_V=$OPT_V \
        LD_PRELOAD="${_preload_opt}" "$@" 1>&3
    else
        TCPSNITCH_OPT_B=$OPT_B TCPSNITCH_OPT_C=$OPT_C TCPSNITCH_OPT_D=$RUN_DIR \
        TCPSNITCH_OPT_E=$OPT_E TCPSNITCH_OPT_F=$OPT_F TCPSNITCH_OPT_L=$OPT_L \
        TCPSNITCH_OPT_T=$OPT_T TCPSNITCH_OPT_U=$OPT_U TCPSNITCH_OPT_V=$OPT_V \
        LD_PRELOAD="${_preload_opt}" "$@" > /dev/null 2>&1
    fi

    chmod -R 777 "$RUN_DIR" 2>/dev/null

    info "Trace saved in: ${RUN_DIR}"
}


###############################################################################
#                                 ANDROID                                     #
###############################################################################

tcpsnitch_android() {
    cd_script_dir
    
    readonly ANDROID_GIT_HASH=$(cat android_git_hash)
    
    get_android_package "$cmd"
    kill_android_package

    # Output directory setup
    local BASE_DIR="/tmp/tcpsnitch_output"
    local TIMESTAMP=$(date +%Y%m%d_%H%M%S)
    OPT_D="${BASE_DIR}/${cmd}_android_${TIMESTAMP}"
    mkdir -p "$OPT_D"
    chmod 777 "$OPT_D"

    # Desactivate Selinux & Setup Logs Dir
    adb shell su -c setenforce 0
    local LOGS_DIR="/data/data/${PACKAGE}/${NAME}"
    adb shell su -c rm -rf "$LOGS_DIR"
    adb shell su -c mkdir -m 777 -p "$LOGS_DIR"

    # Write meta data
    local meta_dir="$LOGS_DIR/meta"
    adb shell su -c "'mkdir -p $meta_dir'"
    adb shell su -c "'echo ${PACKAGE}        > ${meta_dir}/app'"
    adb shell su -c "'echo ${PACKAGE}        > ${meta_dir}/cmd'"
    adb shell su -c "'uname -r               > ${meta_dir}/kernel'"
    adb shell su -c "'uname -m               > ${meta_dir}/machine'"
    adb shell su -c "'sysctl net             > ${meta_dir}/net 2>/dev/null'"
    adb shell su -c "'echo android           > ${meta_dir}/os'"
    adb shell su -c "'echo ${VERSION}        > ${meta_dir}/version'"
    adb shell su -c "'echo ${ANDROID_GIT_HASH} > ${meta_dir}/git_hash'"
    adb shell su -c "'settings get secure android_id > ${meta_dir}/host_id'"
    adb shell su -c "'dumpsys package ${PACKAGE} 2>/dev/null | grep versionName > ${meta_dir}/app_version'"
    
    for i in $(seq 0 $((${META_OPTIONS_COUNT}-1))); do
        adb shell su -c "'echo ${META_OPTIONS_VALS[$i]} > ${meta_dir}/${META_OPTIONS_NAMES[$i]}'"
    done
    
    # Permissions & Upload lib
    adb shell su -c "chmod -R 777 $LOGS_DIR"
    
    local LIBPATH="/data"
    adb shell su -c chmod 777 /data
    
    # EBPF
    if [[ $OPT_E -eq "1" ]]; then
        assert_lib_present "$ARM_LIB_EBPF"
        info "eBPF mode enabled — pushing eBPF lib"
        adb shell su -c rm -f "${LIBPATH}/${ARM_LIB_EBPF}"
        adb push "${ARM_LIB_EBPF}" "${LIBPATH}" 2>/dev/null
        adb shell su -c "chmod 755 ${LIBPATH}/${ARM_LIB_EBPF}"
        
        # Pousser aussi l'objet noyau BPF
        info "Pushing BPF kernel object"
        adb push "${SCRIPT_DIR}/tcpsnitch_android.bpf.o" "/data/" 2>/dev/null
        adb shell su -c "chmod 644 /data/tcpsnitch_android.bpf.o"
        
        # Injection de la lib eBPF
        adb shell setprop wrap."${PACKAGE:0:26}" LD_PRELOAD="${LIBPATH}/${ARM_LIB_EBPF}"
    else
        assert_lib_present "$ARM_LIB"
        info "Uploading ${NAME} library to ${LIBPATH}/${ARM_LIB}"
        adb shell su -c rm -f "${LIBPATH}/${ARM_LIB}"
        adb push "${ARM_LIB}" "${LIBPATH}" 2>/dev/null
        adb shell su -c chmod 755 "${LIBPATH}/${ARM_LIB}"
        
        # Injection de la lib standard
        adb shell setprop wrap."${PACKAGE:0:26}" LD_PRELOAD="${LIBPATH}/${ARM_LIB}"
    fi

    # Properties
    adb shell setprop "${PROP_PREFIX}.opt_b"    "$OPT_B"
    adb shell setprop "${PROP_PREFIX}.opt_d"    "$LOGS_DIR"
    adb shell setprop "${PROP_PREFIX}.opt_f"    "$OPT_F"
    adb shell setprop "${PROP_PREFIX}.opt_l"    "$OPT_L"
    adb shell setprop "${PROP_PREFIX}.opt_t"    "$OPT_T"
    adb shell setprop "${PROP_PREFIX}.opt_u"    "$OPT_U"
    adb shell setprop "${PROP_PREFIX}.opt_v"    "$OPT_V"
    adb shell setprop "${PROP_PREFIX}.opt_e"    "$OPT_E"
    adb shell setprop "${PROP_PREFIX}.opt_b"    "$OPT_B"
    adb shell setprop "${PROP_PREFIX}.opt_d"    "$LOGS_DIR"

    # Save properties for teardown (-k)
    adb shell setprop "${PROP_PREFIX}.opt_d_k"  "$OPT_D"

    start_android_package
    info "Execute '${NAME} -k ${cmd}' to terminate the capture"
}

tcpsnitch_android_teardown() {
    OPT_D=$(adb shell getprop "${PROP_PREFIX}.opt_d_k" | tr -d '\r')
    
    get_android_package "${2}"
    kill_android_package
    pull_trace_for_android_package
}


###############################################################################
#                                MAIN SCRIPT                                  #
###############################################################################

trap "exit 1" TERM

parse_options "$@"
shift $((OPTIND - 1))

validate_args_number "$@"
cmd="$1"

if [[ $OPT_A -eq "1" ]]; then
    tcpsnitch_android "$@"
else
    tcpsnitch_linux "$@"
fi